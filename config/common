#!/bin/sh
# config/common — статические настройки live-build для всех релизов.
#
# live-build ПЕРЕД разбором аргументов `lb config` читает config/common как
# «сохранённую конфигурацию» (см. /usr/share/live/build/functions/conffile.sh).
# Поэтому значения отсюда применяются без дублирования флагов в
# scripts/inside-build.sh: там передаются только различия релиза
# (дистрибутив, зеркала, security) и вычисляемые параметры (имя образа).
#
# Имена переменных — канонические LB_* из live-build 1:20250505+deb13u1.
# Внимание: CLI-флаг --binary-image соответствует переменной LB_IMAGE_TYPE
# (а не LB_BINARY_IMAGES), а ядро задаётся парой LB_LINUX_PACKAGES +
# LB_LINUX_FLAVOURS_WITH_ARCH — live-build сам добавляет -<flavour>.
#
# Различия релиза — только в profiles/<target>.conf.

# --- Архитектура и режим ---
LB_ARCHITECTURE="amd64"
LB_MODE="debian"

# --- Компоненты архива: только официальные ---
# contrib нужен для b43-обвязки, non-free-firmware — для Wi-Fi/GPU/NVMe.
LB_ARCHIVE_AREAS="main contrib non-free-firmware"
LB_PARENT_ARCHIVE_AREAS="main contrib non-free-firmware"

# --- Бинарный образ: гибридный ISO (BIOS + UEFI) ---
LB_IMAGE_TYPE="iso-hybrid"
LB_BINARY_FILESYSTEM="fat32"
LB_BOOTLOADERS="syslinux grub-efi"
LB_CHROOT_FILESYSTEM="squashfs"
LB_CHROOT_SQUASHFS_COMPRESSION_TYPE="zstd"
LB_INITRAMFS="live-boot"
LB_INITSYSTEM="systemd"

# --- debian-installer не включаем: ставим Calamares (Этап 6) ---
LB_DEBIAN_INSTALLER="none"

# --- Ядро ---
# live-build подставит flavour сам: linux-image + amd64 = linux-image-amd64.
LB_LINUX_PACKAGES="linux-image"

# --- Прошивки ---
# LB_FIRMWARE_CHROOT=true заставляет live-build собрать список всех firmware-*
# из archive-areas и установить их в chroot (Этап 5).
LB_FIRMWARE_CHROOT="true"
LB_FIRMWARE_BINARY="false"

# --- APT ---
LB_APT_INDICES="false"
LB_APT_RECOMMENDS="true"
LB_APT_SECURE="true"
LB_APT_SOURCE_ARCHIVES="false"

# --- Кэш для итеративной сборки ---
LB_CACHE="true"
LB_CACHE_PACKAGES="true"
LB_CACHE_INDICES="false"
LB_CACHE_STAGES="bootstrap chroot"

# --- Контрольные суммы файлов на образе ---
LB_CHECKSUMS="sha256"

# --- Брендинг PuraD (рабочее имя: менять только здесь и в branding/) ---
LB_ISO_APPLICATION="PuraD"
LB_ISO_PREPARER="PuraD Project"
LB_ISO_PUBLISHER="PuraD Project"
LB_ISO_VOLUME="PURAD"

# --- Параметры загрузки live-сессии ---
# X11 фиксируется хуком SDDM (Этап 4); здесь только поведение ядра/live-boot.
# console=ttyS0 — serial-консоль для headless-проверок в qemu (scripts/test-boot.sh);
# последний console= становится /dev/console, поэтому tty0 идёт до ttyS0.
LB_BOOTAPPEND_LIVE="boot=live components splash console=tty0 console=ttyS0,115200n8"
LB_BOOTAPPEND_LIVE_FAILSAFE="boot=live components nomodeset console=tty0 console=ttyS0,115200n8"

# --- Сборка только внутри контейнера, интерактив не нужен ---
LB_INTERACTIVE="false"
LB_UTC_TIME="true"
