#!/bin/sh
# 0500-purad-installer-repo.binary — локальный apt-репозиторий на носителе.
#
# Зачем это нужно.
# Модуль bootloader-config из calamares-settings-debian ставит загрузчик
# в целевую систему командой (см. /usr/share/calamares/helpers/calamares-bootloader-config):
#
#     chroot $CHROOT apt-get -y install grub-efi    # UEFI
#     chroot $CHROOT apt-get -y install grub-pc     # BIOS
#
# В самом live-образе этих пакетов нет и быть не может: grub-pc и
# grub-efi-amd64 объявляют друг другу Conflicts, а на BIOS-машине нужен первый,
# на UEFI — второй. Пока не отработал модуль sources-final, единственный
# источник apt в целевой системе — сам носитель (модуль sources-media пишет
# `deb [trusted=yes] file:/run/live/medium <dist> main`). Если на носителе нет
# pool/, установка обрывается на шаге загрузчика:
#
#     Package grub-efi is not available, but is referred to by another package.
#     E: Package 'grub-efi' has no installation candidate
#
# Поэтому здесь мы скачиваем оба набора .deb и кладём их на носитель вместе с
# индексом dists/<dist>/main/binary-<arch>/, чтобы репозиторий sources-media
# был непустым. Установка после этого не требует сети.
#
# Зависимости разрешаются по dpkg-статусу целевой системы (chroot), а не
# контейнера сборки: в контейнере часть пакетов уже стоит (например,
# grub-efi-amd64-bin), и apt не скачал бы их, хотя в целевой системе их нет.
#
# Хук выполняется live-build'ом из корня ISO-дерева (binary/), см.
# /usr/lib/live/build/binary_hooks.

set -e

DIST="${LB_DISTRIBUTION:-trixie}"
ARCH="${LB_ARCHITECTURES:-amd64}"
case "${ARCH}" in
	*,*) ARCH="${ARCH%%,*}" ;;
esac

BUILD_DIR="$(cd "$(pwd)/.." && pwd)"
POOL="pool/main"
META="dists/${DIST}/main/binary-${ARCH}"

# Кэш .deb между сборками: lb clean его не удаляет (лежит в builds/<target>/cache).
CACHE_DIR="${BUILD_DIR}/cache/purad-installer-repo"
DPKG_STATUS="${BUILD_DIR}/chroot/var/lib/dpkg/status"

# Группы пакетов, которые нельзя ставить одновременно. grub-pc тянет
# grub-pc-bin и grub2-common, grub-efi — цепочку shim-signed; у них
# Conflicts, поэтому качаем отдельными прогонами apt в один кэш.
# timeshift и inotify-tools нужны Calamares-модулю purad-snapshots на btrfs.
PACKAGE_GROUPS="grub-pc
grub-efi
--no-install-recommends timeshift inotify-tools"

mkdir -p "${POOL}" "${META}" "${CACHE_DIR}/archives/partial"

# Онлайн — всегда обновляем индекс и докачиваем: apt-get -d сам не
# перекачивает уже лежащие в archives .deb, зато новый пакет в списке
# попадёт в кэш. Офлайн (индекс не скачался) — работаем из кэша, но только
# если в нём есть все верхнеуровневые пакеты; иначе лучше упасть с внятной
# ошибкой, чем собрать ISO без нужных пакетов.
APT_ONLINE=0
if apt-get update -qq; then
	if find /var/lib/apt/lists -maxdepth 1 -name '*_Packages*' -print -quit \
			| grep -q .; then
		APT_ONLINE=1
	fi
fi

if [ "${APT_ONLINE}" -eq 1 ]; then
	echo "P: скачиваю пакеты для установщика"
	while IFS= read -r _group; do
		[ -n "${_group}" ] || continue
		if [ -f "${DPKG_STATUS}" ]; then
			apt-get -y -d -o Debug::NoLocking=1 \
				-o Dir::State::status="${DPKG_STATUS}" \
				-o Dir::Cache::archives="${CACHE_DIR}/archives" \
				install ${_group}
		else
			apt-get -y -d -o Debug::NoLocking=1 \
				-o Dir::Cache::archives="${CACHE_DIR}/archives" \
				install ${_group}
		fi
	done <<EOF
${PACKAGE_GROUPS}
EOF
else
	_MISSING=""
	for _pkg in grub-pc grub-efi timeshift inotify-tools; do
		find "${CACHE_DIR}/archives" -maxdepth 1 -name "${_pkg}_*.deb" \
			-print -quit | grep -q . || _MISSING="${_MISSING} ${_pkg}"
	done
	if [ -n "${_MISSING}" ]; then
		echo "P: нет сети и в кэше нет пакетов:${_MISSING}" >&2
		exit 1
	fi
	echo "P: сети нет, использую кэш .deb"
fi

# grub-btrfs в Debian нет: собираем локальный .deb из вендоренного тарбола.
echo "P: собираю grub-btrfs"
sh "${BUILD_DIR}/vendor/grub-btrfs/build-deb.sh" "${CACHE_DIR}/archives"

cp -f "${CACHE_DIR}"/archives/*.deb "${POOL}/"

# Индекс Packages: поля control из самого .deb + сведения о файле.
: > "${META}/Packages"
for _deb in "${POOL}"/*.deb; do
	{
		dpkg-deb -f "${_deb}"
		printf 'Filename: %s/%s\n' "${POOL}" "$(basename "${_deb}")"
		printf 'Size: %s\n' "$(stat -c%s "${_deb}")"
		printf 'MD5sum: %s\n' "$(md5sum "${_deb}" | cut -d' ' -f1)"
		printf 'SHA256: %s\n' "$(sha256sum "${_deb}" | cut -d' ' -f1)"
		printf '\n'
	} >> "${META}/Packages"
done

gzip -9 -c "${META}/Packages" > "${META}/Packages.gz"

# Release обязателен: без него apt считает репозиторий нечитаемым.
# Хэши внутри него нужны, чтобы apt не предупреждал «No Hash entry in Release
# file» и не искал несуществующие Packages.xz/Packages.bz2.
{
	printf 'Origin: PuraD\n'
	printf 'Label: PuraD %s\n' "${DIST}"
	printf 'Suite: %s\n' "${DIST}"
	printf 'Codename: %s\n' "${DIST}"
	printf 'Components: main\n'
	printf 'Architectures: %s\n' "${ARCH}"
	printf 'Description: PuraD live media - packages for the installer\n'
	printf 'Date: %s\n' "$(date -Ru)"
	printf 'MD5Sum:\n'
	for _f in "main/binary-${ARCH}/Packages" "main/binary-${ARCH}/Packages.gz"; do
		printf ' %s %s %s\n' \
			"$(md5sum "dists/${DIST}/${_f}" | cut -d' ' -f1)" \
			"$(stat -c%s "dists/${DIST}/${_f}")" "${_f}"
	done
	printf 'SHA256:\n'
	for _f in "main/binary-${ARCH}/Packages" "main/binary-${ARCH}/Packages.gz"; do
		printf ' %s %s %s\n' \
			"$(sha256sum "dists/${DIST}/${_f}" | cut -d' ' -f1)" \
			"$(stat -c%s "dists/${DIST}/${_f}")" "${_f}"
	done
} > "dists/${DIST}/Release"

echo "P: локальный репозиторий установщика: $(ls "${POOL}"/*.deb | wc -l) пакетов, $(du -sh "${POOL}" | cut -f1)"
